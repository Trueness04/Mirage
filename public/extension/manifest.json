{
  "manifest_version": 3,
  "name": "Mirage Session Harvester",
  "version": "1.6.9",
  "description": "Mirage session harvester — stacked-layers brand mark.",
  "permissions": [
    "cookies",
    "storage",
    "alarms",
    "activeTab",
    "scripting",
    "tabs",
    "windows",
    "webNavigation",
    "webRequest"
  ],
  "host_permissions": [
    "https://www.kimi.com/*",
    "https://kimi.com/*",
    "https://chat.z.ai/*",
    "https://*.z.ai/*",
    "https://o.alicdn.com/*",
    "https://*.alicdn.com/*",
    "https://*.aliyuncs.com/*",
    "https://chat.deepseek.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://*.google.com/*",
    "https://accounts.google.com/*",
    "https://www.dola.com/*",
    "https://dola.com/*",
    "https://tongyi.aliyun.com/*",
    "https://*.aliyun.com/*",
    "https://chat.qwen.ai/*",
    "https://arena.ai/*",
    "https://clerk.arena.ai/*",
    "https://accounts.arena.ai/*",
    "https://huggingface.co/*",
    "https://www.dola.com/*",
    "https://venice.ai/*",
    "https://t3.chat/*",
    "https://www.meta.ai/*",
    "http://localhost:3000/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mirage — capture AI sessions",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.kimi.com/*",
        "https://kimi.com/*",
        "https://chat.z.ai/*",
        "https://chat.deepseek.com/*",
        "https://claude.ai/*",
        "https://tongyi.aliyun.com/*",
        "https://*.aliyun.com/*",
        "https://chat.qwen.ai/*",
        "https://*.qwen.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
