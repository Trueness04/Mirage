DATABASE_URL="file:./dev.db"

# Protects dashboard + admin APIs (/api/dashboard, /keys, /sessions, …)
# Required in production. In development, localhost works without it.
MIRAGE_ADMIN_SECRET="change-me-to-a-long-random-string"

# Optional shared secret accepted by all extension installs (in addition to per-device secrets)
# MIRAGE_EXTENSION_SECRET=""
